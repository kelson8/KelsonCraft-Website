---
import {blueLinkCss} from "@/util/constants.ts";
const {href} = Astro.props;

interface Props {
    // The url to go to for the link.
    href: string;
    // If the url will be opened in a new tab, should I make this a required option?
    openUrlInNewTab?: boolean;
}

const { openUrlInNewTab } = Astro.props;

// TODO Come up with a better solution for this later, this is what I did for now.
---

{openUrlInNewTab && <a href={href} class={blueLinkCss} target="_blank" rel="noopener noreferrer">
    <slot/>
</a>}

{!openUrlInNewTab && <a href={href} class={blueLinkCss} rel="noopener noreferrer">
    <slot/>
</a>}

