---
// Display custom tables for use with my website.

// https://www.jorqensen.dev/blog/2024/writing-components-with-astro-and-tailwind


import Link from "@/components/link.astro";
interface Props {
    headers: string[];
    rows: string[][];
    // This toggles the blue url link for the specified table section.
    urlToggle?: boolean;
    // The spot on the table that the url is, such as table section 2.
    // Look into src/projects/index.astro for the usage of this.
    urlTableIndex?: number;
}

const { headers, rows, urlToggle, urlTableIndex } = Astro.props

---

<div class="relative overflow-x-auto bg-neutral-primary-soft shadow-xs rounded-base border border-default">
    <table class="w-full text-sm text-left rtl:text-right text-body">
        <thead class="text-sm text-body bg-neutral-secondary-soft border-b rounded-base border-default">
        <tr>
            {headers.map((header) => (
                    <th scope="col" class="px-6 py-3 font-medium">
                        {header}
                    </th>
            ))}


            <!--<th scope="col" class="px-6 py-3 font-medium">-->
            <!--    {text.title}-->
            <!--</th>-->
            <!--<th scope="col" class="px-6 py-3 font-medium">-->
            <!--    {text.description}-->
            <!--</th>-->
        </tr>
        </thead>

        {/* Table Body */}
        <tbody>
        {rows.map((row) => (
                <tr class="bg-neutral-primary border-b border-default last:border-b-0">
                    {row.map((cell, index) => {
                        // Renders the first column as a semantic <th> for better accessibility
            if (index === 0) {
                            return (
                                    <th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">
                                        {cell}
                                    </th>
                            );
                        }


                        // I modified this to only set the specific table section as an 'a' tag.
                        // This fixes my projects page and other items I need to use with this table.
                        if(index === urlTableIndex && urlToggle) {
                            return (
                                    <td class="px-6 py-4"><Link href={cell} openUrlInNewTab={true}>{cell}</Link></td>
                            )
                        }

                        // Renders standard table cells for the rest
            return <td class="px-6 py-4">{cell}</td>;
                    })}
                </tr>
        ))}
        </tbody>


            <!--<th scope="row" class="px-6 py-4 font-medium text-heading whitespace-nowrap">-->
            <!--    {text.language}-->
            <!--</th>-->
            <!--<td class="px-6 py-4">-->
            <!--    {text.tableText}-->
            <!--</td>-->
    </table>
</div>