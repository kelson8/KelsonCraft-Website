---
// import { Footer } from '../components/footer';
import Footer from '../components/footer.astro';
import Navbar from '../components/navbar.astro';
import DiscordSvg from '@/components/discord/discord-svg.html';


import {containerPageClass, websiteName} from "../util/constants.ts";

import {ThemeToggle} from "../components/theme-toggle.tsx"

// I moved the dark mode color into this file.
import "@/styles/starwind.css";

//

// The title gets set to the website name if it isn't set.
const { title = websiteName } = Astro.props;

---

<!doctype html>
<html lang="en">
	<head>

		<link rel="sitemap" href="/sitemap-index.xml" />

		<!-- https://ui.shadcn.com/docs/dark-mode/astro -->
		<script is:inline>
			const getThemePreference = () => {
				if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
					return localStorage.getItem('theme');
				}
				return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
			};
			const isDark = getThemePreference() === 'dark';
			document.documentElement.classList[isDark ? 'add' : 'remove']('dark');

			if (typeof localStorage !== 'undefined') {
				const observer = new MutationObserver(() => {
					const isDark = document.documentElement.classList.contains('dark');
					localStorage.setItem('theme', isDark ? 'dark' : 'light');
				});
				observer.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
			}
		</script>

		<!-- Font awesome -->
		<!-- https://cdnjs.com/libraries/font-awesome -->
		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/fontawesome.min.css"
			  integrity="sha512-M5Kq4YVQrjg5c2wsZSn27Dkfm/2ALfxmun0vUE3mPiJyK53hQBHYCVAtvMYEC7ZXmYLg8DVG4tF8gD27WmDbsg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/solid.min.css"
			  integrity="sha512-EHa6vH03/Ty92WahM0/tet1Qicl76zihDCkBnFhN3kFGQkC+mc86d7V+6y2ypiLbk3h0beZAGdUpzfMcb06cMg==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/brands.min.css"
			  integrity="sha512-WxpJXPm/Is1a/dzEdhdaoajpgizHQimaLGL/QqUIAjIihlQqlPQb1V9vkGs9+VzXD7rgI6O+UsSKl4u5K36Ydw==" crossorigin="anonymous" referrerpolicy="no-referrer" />

		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, minimum-scale=1">
		<!--<link rel="icon" type="image/svg+xml" href="/favicon.svg" />-->
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
        <link rel="stylesheet" href="/css/discord.css">
        <link href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.15.6/styles/solarized-dark.min.css" rel="stylesheet" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/9.15.6/highlight.min.js">
        </script>

        <script src="/js/discord-scripts.js" is:inline></script>

    <title>{title}</title>

    <!-- <link rel="stylesheet" href="/static/css/tailwind.css"> -->

    <link rel="icon" type="image/x-icon" href="/favicon.ico">

    <script>
        // Check stored theme and apply it immediately
        const storedTheme = localStorage.getItem('theme');
        if (storedTheme) {
            document.documentElement.classList.add(storedTheme);
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
            document.documentElement.classList.add('dark');
        }
    </script>

	<DiscordSvg />



		<!--<title>{Astro.props.title}</title>-->
		
	</head>
	<body>

	{/* Using new navbar from here https://github.com/surjithctly/astro-navbar */}
	<Navbar />
		<main>
			{/* Don't enable the background styles here, shadcn takes care of that. */}
			{/* <div class="p-4 sm:p-6 lg:p-8 dark:bg-gray-800 bg-white"> */}
			<div class="p-4 sm:p-6 lg:p-8">
				<br></br>
				<br></br>

				 <!-- <div class={containerPageClass}> -->

				<slot />
				<!-- </div> -->
			</div>
		</main>

	{/* <div class="flex items-center bg-blue-500 px-4 py-2 text-white hover:bg-blue-400 rounded-full fixed bottom-2 right-2"> */}

	{/*
	<!-- Disabled for Discord layout pages. --> 
	<div class="flex items-center px-4 py-2  rounded-full fixed bottom-2 right-2">
		<ThemeToggle client:load />
		<!--<ThemeToggle />-->

	</div>
	*/}

	<Footer />



	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
