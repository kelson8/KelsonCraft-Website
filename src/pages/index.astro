        <!--         height={128}></img>-->
        <!--</div>-->

        <h1 class={h2HeaderClass + " text-center"}>Website Links</h1>
        <ul>
            <li> Site Blog:
                <Link href="https://blog.kelsoncraft.net/" openUrlInNewTab={true}> https://wiki.kelsoncraft.net/en/home
                </Link>
                    <li> Site Wiki:
                        <Link href="https://wiki.kelsoncraft.net/en/home" openUrlInNewTab={true}>
                            https://wiki.kelsoncraft.net/en/home
                        </Link>
                    </li>
                    <li> Site Discord:
                        <Link href="https://discord.com/invite/tdg2Bf9PpT" openUrlInNewTab={true}>
                            https://discord.com/invite/tdg2Bf9PpT
                        </Link>
                    </li>
                    <li> My github:
                        <Link href="https://github.com/kelson8" openUrlInNewTab={true}> https://github.com/kelson8
                        </Link>
                    </li>
                    <li> KCNet-Godot-Test (Godot Test game in GDScript and C#):
