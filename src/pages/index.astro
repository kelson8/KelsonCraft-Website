---
import {HomePageLogo} from '../components/page_layouts/home-page-components';
import BaseLayout from '../layouts/base-layout.astro';
import Link from "@/components/link.astro";
import {h2HeaderClass} from "@/util/constants.ts";
import BreadcrumbLink from "../components/starwind/breadcrumb/BreadcrumbLink.astro";

// I can place variables in the front matter which is what this is called between the '---'.

// I quickly got dark theme toggles working with shadcn
---

<BaseLayout title="Home">

    <h1 class="text-4xl text-indigo-500 text-center text-bold">
        Home Page
        <i class="fa-solid fa-server dark:text-white text-black"></i>
    </h1>

    <div>
        <!--<MainContainer pageHeader="Home Page" pageIcon={websiteHomeIcon} headerColor="text-indigo-500">-->
        <br>

        <!-- Adapted from HomePageContents on the Next.js website. -->
        <p>Welcome to the new KelsonCraft website, this website is
            using
            Astro with Typescript and Tailwind CSS. The old one was using Python Flask and Bootstrap
            CSS.</p>
        <br>

        <p> I started working on this new website on May 29, 2026. <br>
            Now the videos page works on here, the about page, and the projects page are all working also. </p>
        <br>
        <p>
            This website will contain my projects that I have created on Github within the
            <Link href="/projects">/projects</Link>
            page on the website.
            And this website will contain other misc items that I work on.

            <br>
            I may eventually switch my videos page to embedding to my own YouTube videos if I publish more.
        </p>

        <br>
        <hr></hr>

        <!-- KelsonCraft logo, TODO Make this work in this astro file, it doesn't center proprely so I'll leave it in
         home-page-components.tsx..-->
